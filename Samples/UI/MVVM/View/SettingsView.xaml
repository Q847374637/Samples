<UserControl x:Class="Samples.UI.MVVM.View.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"  
             xmlns:viewModel="clr-namespace:Samples.UI.MVVM.ViewModel"
             xmlns:local="clr-namespace:Samples" xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid x:Name="Settings">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="500"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="55"/>
            <RowDefinition Height="300"/>
            <RowDefinition/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <StackPanel  Grid.Row="0"
                     Grid.Column="1">
            <TextBlock Text="Настройки:"
                   Foreground="White"
                   FontSize="28"
                   HorizontalAlignment="Left"
                   FontFamily="/UI/Fonts/#Comfortaa Medium"/>
        </StackPanel >
        <StackPanel Grid.Row="1"
                     Grid.Column="1">
            <Grid x:Name="Pathes">
                <Grid.RowDefinitions>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="45"/>
                    <RowDefinition Height="45"/>
                    <RowDefinition Height="25"/>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="45"/>
                    <RowDefinition Height="45"/>
                    <RowDefinition Height="25"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0"
                            VerticalAlignment="Top">
                    <TextBlock Text="Delay:"
                   Foreground="White"
                   FontSize="20"
                   HorizontalAlignment="Left"
                   FontFamily="/UI/Fonts/#Comfortaa Medium"
                               FontWeight="Medium"/>
                </StackPanel>
                <StackPanel Grid.Row="1">
                <StackPanel Orientation="Horizontal">
                    <TextBox FontFamily="/UI/Fonts/#Comfortaa Medium"
                     FontWeight="Light"
                     FontSize="16"
                     HorizontalAlignment="Left"
                     Foreground="White"
                     Background="Transparent"
                     BorderThickness="0"
                     HorizontalContentAlignment="Left"
                     Opacity="0.5"
                     Height="22"
                     Width="350"
                     Name="textboxDelayIn">
                    </TextBox>
                    <iconPacks:PackIconJamIcons Kind="ArrowUp"
                             Width="15"
                             Height="15"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Top"
                             Foreground="White"/>
                </StackPanel>
                <Border Width="400"
                    Height="1.5"
                    Background="White"
                    Opacity="0.5"
                        HorizontalAlignment="Left"/>
                </StackPanel>
                <StackPanel Grid.Row="2">
                    <StackPanel Orientation="Horizontal">
                        <TextBox FontFamily="/UI/Fonts/#Comfortaa Medium"
                     FontWeight="Light"
                     FontSize="16"
                     HorizontalAlignment="Left"
                     Foreground="White"
                     Background="Transparent"
                     BorderThickness="0"
                     HorizontalContentAlignment="Left"
                     Opacity="0.5"
                     Height="22"
                     Width="350"
                     Name="textboxDelayOut">
                        </TextBox>
                        <iconPacks:PackIconJamIcons Kind="ArrowDown"
                             Width="15"
                             Height="15"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Top"
                             Foreground="White"/>
                    </StackPanel>
                    <Border Width="400"
                    Height="1.5"
                    Background="White"
                    Opacity="0.5"
                        HorizontalAlignment="Left"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                    Margin="0,0,140,0"
                    Grid.Row="3"
                            HorizontalAlignment="Right">
                    <Button x:Name="buttonSetDefaultDelay"
    Content="Сбросить"
    Width="110"
    Click="buttonSetDefaultDelay_Click"
    IsDefault="True"
    Foreground="White"
    BorderBrush="White"
    FontSize="14">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="FontFamily" Value="/UI/Fonts/#Comfortaa Bold"/>
                                <Setter Property="Background" Value="#383660"/>
                                <Setter Property="Cursor" Value="Hand"/>

                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FF4C70"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Width="100"
                    Height="25"
                    CornerRadius="12"
                    Background="{TemplateBinding Background}" Margin="0,0,-25,0">
                                    <ContentPresenter VerticalAlignment="Center"
                                  HorizontalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
                <StackPanel Grid.Row="4"
                            VerticalAlignment="Top">
                    <TextBlock Text="Easypay:"
                   Foreground="White"
                   FontSize="20"
                   HorizontalAlignment="Left"
                   FontFamily="/UI/Fonts/#Comfortaa Medium"
                               FontWeight="Medium"/>
                </StackPanel>
                <StackPanel Grid.Row="5">
                    <StackPanel Orientation="Horizontal">
                        <TextBox FontFamily="/UI/Fonts/#Comfortaa Medium"
                     FontWeight="Light"
                     FontSize="16"
                     HorizontalAlignment="Left"
                     Foreground="White"
                     Background="Transparent"
                     BorderThickness="0"
                     HorizontalContentAlignment="Left"
                     Opacity="0.5"
                     Height="22"
                     Width="350"
                     Name="textboxEasypayIn">
                        </TextBox>
                        <iconPacks:PackIconJamIcons Kind="ArrowUp"
                             Width="15"
                             Height="15"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Top"
                             Foreground="White"/>
                    </StackPanel>
                    <Border Width="400"
                    Height="1.5"
                    Background="White"
                    Opacity="0.5"
                        HorizontalAlignment="Left"/>
                </StackPanel>
                <StackPanel Grid.Row="6">
                    <StackPanel Orientation="Horizontal">
                        <TextBox FontFamily="/UI/Fonts/#Comfortaa Medium"
                     FontWeight="Light"
                     FontSize="16"
                     HorizontalAlignment="Left"
                     Foreground="White"
                     Background="Transparent"
                     BorderThickness="0"
                     HorizontalContentAlignment="Left"
                     Opacity="0.5"
                     Height="22"
                     Width="350"
                     Name="textboxEasypayOut">
                        </TextBox>
                        <iconPacks:PackIconJamIcons Kind="ArrowDown"
                             Width="15"
                             Height="15"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Top"
                             Foreground="White"/>
                    </StackPanel>
                    <Border Width="400"
                    Height="1.5"
                    Background="White"
                    Opacity="0.5"
                        HorizontalAlignment="Left"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                    Margin="0,0,140,0"
                    Grid.Row="7"
                            HorizontalAlignment="Right">
                    <Button x:Name="buttonSetDefaultEasypay"
    Content="Сбросить"
    Width="110"
    Click="buttonSetDefaultEasypay_Click"
    IsDefault="True"
    Foreground="White"
    BorderBrush="White"
    FontSize="14">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="FontFamily" Value="/UI/Fonts/#Comfortaa Bold"/>
                                <Setter Property="Background" Value="#383660"/>
                                <Setter Property="Cursor" Value="Hand"/>

                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FF4C70"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Width="100"
                    Height="25"
                    CornerRadius="12"
                    Background="{TemplateBinding Background}" Margin="0,0,-25,0">
                                    <ContentPresenter VerticalAlignment="Center"
                                  HorizontalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </StackPanel>

    <StackPanel Orientation="Horizontal"
                    Margin="0,0,0,0"
                    Grid.Row="2"
                    Grid.Column="1">
            <Button x:Name="button"
    Content="Сохранить"
    Width="110"
    Click="buttonSaveSettings_Click"
    IsDefault="True"
    Foreground="White"
    BorderBrush="White"
    FontSize="18"
    VerticalAlignment="Bottom">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="FontFamily" Value="/UI/Fonts/#Comfortaa Bold"/>
                        <Setter Property="Background" Value="#FE6584"/>
                        <Setter Property="Cursor" Value="Hand"/>

                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF4C70"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Width="130"
                    Height="35"
                    CornerRadius="12"
                    Background="{TemplateBinding Background}" Margin="0,0,-25,0">
                            <ContentPresenter VerticalAlignment="Center"
                                  HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
