<UserControl x:Class="Samples.UI.MVVM.View.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Samples.UI.MVVM.View"
             xmlns:viewModel="clr-namespace:Samples.UI.MVVM.ViewModel"
             mc:Ignorable="d" 
             d:DesignHeight="450"
             d:DesignWidth="800">
    <Grid x:Name="Settings">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="500"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="55"/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0"
                    Grid.Column="1">
            <TextBlock Text="Выберите тип:"
                   Foreground="White"
                   FontSize="28"
                   HorizontalAlignment="Left"
                   Margin="10,0,0,20"
                   FontFamily="/UI/Fonts/#Comfortaa Medium"/>
        </StackPanel>
        <StackPanel Grid.Row="1"
                    Grid.Column="1">
            <RadioButton
        x:Name="radioButtonDE"
        GroupName="Samples"
        Content="Delay &amp; Easypay"
        Foreground="White"
        FontSize="18"
        IsChecked="True"
        Style="{StaticResource MenuButtonTheme}"
        FontFamily="/UI/Fonts/#Comfortaa Regular"
            Checked=" radioButtonDE_Checked"/>

            <RadioButton x:Name="radioButtonD"
                 GroupName="Samples"
                 Content="Delay"
                 Foreground="White"
                 FontSize="18"
                 Margin="0,15,0,0"
                 Style="{StaticResource MenuButtonTheme}"
                 FontFamily="/UI/Fonts/#Comfortaa Regular"
                     Checked="radioButtonD_Checked"/>

            <RadioButton x:Name="radioButtonE"
                 GroupName="Samples"
                 Content="Easypay"
                 Foreground="White"
                 FontSize="18"
                 Margin="0,15,0,0"
                 Style="{StaticResource MenuButtonTheme}"
                 FontFamily="/UI/Fonts/#Comfortaa Regular"
                     Checked="radioButtonE_Checked"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal"
                    Grid.Row="2"
                    Grid.Column="1">
            <Button x:Name="button"
    Content="Пуск"
    Width="100"
    Click="button_Click"
    IsDefault="True"
    Foreground="White"
    BorderBrush="White"
    FontSize="18"
    VerticalAlignment="Bottom">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="FontFamily" Value="/UI/Fonts/#Comfortaa Bold"/>
                            <Setter Property="Background" Value="#FE6584"/>
                            <Setter Property="Cursor" Value="Hand"/>

                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FF4C70"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Width="110"
                    Height="35"
                    CornerRadius="12"
                    Background="{TemplateBinding Background}" Margin="0,0,-25,0">
                                <ContentPresenter VerticalAlignment="Center"
                                  HorizontalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
    </Grid>
</UserControl>
